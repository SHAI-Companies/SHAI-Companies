# SHAI Companies — Strategic Hospitality Analytical Intelligence
# Environment template. Copy to `.env` and fill real values. NEVER commit `.env` to git.

# ─── Server ──────────────────────────────────────────────────────────
# Default 3001 so SHAI Companies can run alongside the Superhost Hub (3000) on the same machine.
PORT=3001

# Optional PIN gate on the dashboard (leave blank for no gate)
# HUB_PIN=

# ─── AI providers ────────────────────────────────────────────────────
# Primary: Anthropic Claude. Generate at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Model overrides (optional)
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Fallback (optional)
GROQ_API_KEY=

# ─── PMS / financial data integrations ───────────────────────────────
# Per-tenant. Fill in via per-tenant config.json or env — do NOT commit credentials here.
# PROFITSAGE_USERNAME=
# PROFITSAGE_PASSWORD=
